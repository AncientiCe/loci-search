{
  "workload":"logs",
  "version":1,
  "documents":[],
  "steps":[
    {"append_series":{"prefix":"hour","count":24,"start":0,"seconds_between":3600,"trace":"heartbeat"}},
    {"upsert":{"id":"edge-before","time":299,"trace":"trace-42"}},
    {"upsert":{"id":"edge-after","time":300,"trace":"trace-42"}},
    {"id":"trace","select":{"filter":{"trace":{"eq":"trace-42"}},"sort":"time"},"expect":{"ids":["edge-before","edge-after"],"count":2}},
    {"id":"day-count","select":{"filter":{"time":{"gte":0,"lt":86400}},"sort":"time","limit":1},"expect":{"ids":["hour00"],"count":26}},
    {"id":"five-minutes","select":{"histogram":{"start":0,"end":1200,"width":300}},"expect":{"buckets":[[0,2],[300,1],[600,0],[900,0]]}},
    {"upsert":{"id":"late","time":599,"trace":"trace-42"}},
    {"id":"after-late","select":{"histogram":{"start":0,"end":1200,"width":300}},"expect":{"buckets":[[0,2],[300,2],[600,0],[900,0]]}},
    {"expire_before":300},
    {"restart":true},
    {"id":"post-restart","select":{"filter":{"trace":{"eq":"trace-42"}},"sort":"time"},"expect":{"ids":["edge-after","late"],"count":2}},
    {"id":"retained-day","select":{"filter":{"time":{"gte":0,"lt":86400}},"sort":"time","limit":1},"expect":{"ids":["edge-after"],"count":25}},
    {"id":"post-retention-histogram","select":{"histogram":{"start":0,"end":1200,"width":300}},"expect":{"buckets":[[0,0],[300,2],[600,0],[900,0]]}}
  ]
}
