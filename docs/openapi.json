{
  "openapi": "3.1.0",
  "info": {
    "title": "Loci native search service",
    "version": "0.1.0-preview"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Document": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": true
          },
          "readers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "embed": {
            "type": "boolean",
            "default": true,
            "description": "When false, the document stays lexical and is omitted from embedding and model rebuilds."
          }
        },
        "additionalProperties": false
      },
      "Mutation": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "document"
            ],
            "properties": {
              "op": {
                "const": "upsert"
              },
              "document": {
                "$ref": "#/components/schemas/Document"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "id"
            ],
            "properties": {
              "op": {
                "const": "delete"
              },
              "id": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "model": {
            "enum": [
              "lexical",
              "bge-small-en-v1.5",
              "multilingual-e5-small"
            ]
          },
          "mappings": {
            "type": "object"
          },
          "stream": {
            "type": "object",
            "required": [
              "timestamp",
              "rollover_seconds",
              "retention_seconds"
            ],
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "rollover_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "retention_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "automatic": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default_visibility": {
            "enum": [
              "public",
              "private"
            ]
          }
        }
      },
      "Search": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "regional",
              "exact"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "filter": {
            "type": "object"
          },
          "sort": {
            "type": "array"
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aggregations": {
            "type": "object"
          },
          "cursor": {
            "type": "string"
          },
          "generation": {
            "type": "integer"
          },
          "fuzzy": {
            "type": "boolean"
          },
          "synonyms": {
            "type": "object"
          },
          "boosts": {
            "type": "object"
          },
          "budget": {
            "type": "object",
            "properties": {
              "passages": {
                "type": "integer"
              },
              "regions": {
                "type": "integer"
              },
              "postings": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Read liveness",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "summary": "Read aggregate service counters",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/indexes": {
      "get": {
        "summary": "List visible indexes",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/indexes/{name}": {
      "put": {
        "summary": "Create a named index",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{name}/bulk": {
      "post": {
        "summary": "Commit an atomic document batch",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operations"
                ],
                "properties": {
                  "operations": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Mutation"
                    }
                  }
                }
              }
            },
            "application/x-ndjson": {
              "schema": {
                "type": "string",
                "description": "One native mutation per line"
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{name}/search": {
      "post": {
        "summary": "Search the authorized documents",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Search"
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{name}/suggest": {
      "post": {
        "summary": "Complete a prefix",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prefix"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{name}/documents/{id}": {
      "get": {
        "summary": "Read an authorized source document",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/indexes/{name}/expire": {
      "post": {
        "summary": "Expire events by the configured retention period",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "now"
                ],
                "properties": {
                  "now": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{name}/model": {
      "put": {
        "summary": "Rebuild every document vector and switch the index encoder together",
        "security": [{ "bearer": {} }],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model"],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": ["bge-small-en-v1.5", "multilingual-e5-small"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new model and vectors are visible to later readers",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          },
          "default": { "description": "Request failed" }
        }
      }
    },
    "/v1/indexes/{name}/partitions": {
      "get": {
        "summary": "Inspect event-time partitions",
        "security": [
          {
            "bearer": {}
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    }
  }
}
